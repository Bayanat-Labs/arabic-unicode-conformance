cff-version: 1.2.0
message: "If you use this suite, please cite it as below and name the policy id and policy hash you tested."
type: software
title: "Arabic Unicode Conformance Suite"
version: "0.1.0"
date-released: "2026-10-15"
license: Apache-2.0
repository-code: "https://github.com/Bayanat-Labs/arabic-unicode-conformance"
url: "https://huggingface.co/datasets/Bayanat-Labs/arabic-unicode-conformance"
authors:
